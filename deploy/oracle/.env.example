# Copy to .env and fill in. NEVER commit the real .env.
# Domain that points at the VM (A record -> public IP). Caddy gets TLS for it.
SITE_HOST=video.example.com
SITE_URL=https://video.example.com

# Postgres password for the compose db service (pick a long random string)
DB_PASSWORD=change-me-to-something-long-and-random

# Google Sign-In (same values as in Vercel env; update GOOGLE_REDIRECT_URI to
# https://<SITE_HOST>/api/auth/google/callback and add that URI in the Google
# Cloud Console OAuth client afterwards)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://video.example.com/api/auth/google/callback

# Optional
CRON_SECRET=
FIREBASE_PROJECT_ID=
PROXY_URL=
